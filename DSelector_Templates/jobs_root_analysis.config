# =====================================================================================
# DSelector Analysis Configuration Template
# For use with swif2_dselector.py and swif2_RBHG_DSelector.py
# =====================================================================================
# 
# Key/value pairs are separated by white space
# Lines starting with # and empty lines are ignored
# Only the first two values are evaluated, so for lines like:
#     KEYVALUE VALUE1 VALUE2
# VALUE2 is ignored
# For files & directories: Must specify full path
#
# =====================================================================================

# SCICOMP JOB ACCOUNTING
USER                          acschick
PROJECT                       halld                 # = account: https://scicomp.jlab.org/scicomp/slurmJob/slurmAccount
TRACK                         production            # = partition: https://scicomp.jlab.org/scicomp/slurmJob/slurmInfo
OS                            el9                   # el9 for newest OS

# JOB RESOURCES
NCORES                        1                     # DSelector is single-threaded
DISK                          100MB                 # Minimal disk for DSelector output
RAM                           3GB                   # 3GB typical for DSelector
TIMELIMIT                     8hrs                  # Max time per job

# WORKFLOW DEFINITION
WORKFLOW                      dsel_FFS1_BCFFN_1801_0DEG                # MUST start with a letter!

# JOB, SCRIPT CONTROL
ENVFILE                       /work/halld/home/acschick/channels/batch_submission/2026launch/launch_scripts/launch/version_7.5.0.xml
SCRIPTFILE                    /work/halld/home/acschick/channels/batch_submission/2026launch/launch_scripts/root_analysis/script.sh

# ROOT CONFIG
ROOT_SCRIPT                   /work/halld/home/acschick/channels/batch_submission/2026launch/launch_scripts/root_analysis/Run_Selector.C
TREE_NAME                     epemmissprot__B2_Tree                    # Tree name found in ROOT files
SELECTOR_NAME                 /work/halld/home/acschick/channels/swif2-generator-framework/DSelector_2eMissingProton_Systematics    # Leave .C off!

# FILE INPUT, OUTPUT BASE DIRECTORIES
INDATA_TOPDIR                 /volatile/halld/home/acschick/RBHG/FFS1/BCFFN/1801_0DEG_FFN_DBLRAD/Simulation/root/trees/

# FILE OUTPUT
OUTDIR_LARGE                  /volatile/halld/home/acschick/RBHG/FFS1/BCFFN/1801_0DEG_FFN_DBLRAD/DSelector/
OUTDIR_SMALL                  /volatile/halld/home/acschick/RBHG/FFS1/BCFFN/1801_0DEG_FFN_DBLRAD/DSelector/

# =====================================================================================
# OUTPUT FILENAME HANDLING
# =====================================================================================
# By default, this framework will modify the DSelector's output filenames to include
# unique identifiers (study, nametag, form_factor, run_period, polarization, etc.).
#
# However, if your DSelector has "tokens" or "auto" naming mode (like 
# DSelector_2eMissingProton_Systematics.C), you can bypass the renaming by setting
# BYPASS_FILENAME_MODIFICATION in the Python script.
#
# The "tokens" mode parses the input filename to auto-generate appropriate output names.
# =====================================================================================

