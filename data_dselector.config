# data_dselector.config
#
# High-level configuration for submitting DSelector workflows over real data.
# Used only by swif2_Data_DSelector.py.
#
# This file specifies WHICH data to process and WHERE to put outputs.
# The actual job-level config used by launch.py is generated as
# jobs_root_analysis.config inside each output directory.

# ============================================================================
# DATA SELECTION
# ============================================================================

# Run periods to process (comma-separated, or "ALL")
# Available: 2017, 1801, 1808, 2205
RUN_PERIODS=1801,1808

# Polarizations to process (comma-separated, or "ALL")
# Available: 0DEG, 45DEG, 90DEG, 135DEG, AMO
POLARIZATIONS=0DEG,45DEG,90DEG,135DEG,AMO

# Tree type to analyze (must match directory name in /mss/)
TREE_TYPE=epemmissprot__B2_U1

# Analysis version (e.g., ver17, ver08)
# Format: Run Period -> Analysis Version mapping
ANALYSIS_VERSION_1801=ver17
ANALYSIS_VERSION_1808=ver08
ANALYSIS_VERSION_2017=ver03
ANALYSIS_VERSION_2205=ver01

# ============================================================================
# DSELECTOR CONFIGURATION
# ============================================================================

# Path to DSelector to run
DSELECTOR_PATH={FRAMEWORK_HOME}/DSelector_Templates/2eMissingProton_Systematics/DSelector_2eMissingProton_Systematics.C

# Tree name (auto-detected if not specified)
# TREE_NAME=epemmissprot__B2_U1_Tree

# ============================================================================
# OUTPUT CONFIGURATION
# ============================================================================

# Base output directory on /volatile
OUTPUT_BASE_DIR=/volatile/halld/home/{USERNAME}/RealDataDSelector/{RunPeriod}

# Log directory on /farm_out
LOG_BASE_DIR=/farm_out/{USERNAME}/DSelector_logs/RealDataDSelector/{RunPeriod}

# What to do if an output directory already contains files.
# Options: fail, skip, allow
EXISTING_OUTPUT_MODE=fail

# ============================================================================
# MSS DATA PATHS
# ============================================================================

# Base path to merged trees on tape (auto-constructed if not specified)
# Format: /mss/halld/RunPeriod-{YYYY-MM}/analysis/{ver}/tree_{TREE_TYPE}/merged/
# If specified, overrides auto-construction
# MSS_BASE_PATH=/mss/halld/

# ============================================================================
# WORKFLOW SETTINGS
# ============================================================================

# Workflow name prefix
WORKFLOW_PREFIX=DSELECTOR_DATA

# SWIF2 account and partition
SWIF2_ACCOUNT=halld
SWIF2_PARTITION=production

# Job resources written into generated jobs_root_analysis.config
CORES=1
RAM=4GB
DISK=10GB
TIMELIMIT=2hrs

# ============================================================================
# EXECUTION CONTROL
# ============================================================================

# Run range limits (leave blank to process all runs in RunPeriods.json)
# Format: RUN_MIN-RUN_MAX (e.g., 40000-50000)
# NOTE: swif2_Data_DSelector.py currently uses RunPeriods.json run_range.
# RUN_RANGE=40000-50000

# Maximum jobs per workflow (useful for testing)
# NOTE: swif2_Data_DSelector.py currently does not enforce this setting.
# MAX_JOBS_PER_WORKFLOW=100

# Dry run mode (set to True to preview without submitting)
DRY_RUN=False
